<header class="site-header" role="banner">
  <div class="site-header__inner">
    <a href="/" class="site-header__logo" aria-label="{{ siteConfig.siteTitle }} — home">
      <span aria-hidden="true">👻</span>
      <span class="site-header__title">{{ siteConfig.siteTitle }}</span>
    </a>
    {% if siteConfig.mode === "requesting" and page.url !== "/submit/" %}
      <nav class="site-nav" aria-label="Main navigation">
        <ul class="site-nav__list" role="list">
          <li><a href="/submit/" class="site-nav__link site-nav__link--cta">Request a Haunt</a></li>
        </ul>
      </nav>
    {% endif %}
  </div>
</header>
