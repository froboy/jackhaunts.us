<footer class="site-footer" role="contentinfo">
  <div class="site-footer__inner">
    <p class="site-footer__text">
      {% if siteConfig.haunterIsGone %}
        In loving memory of {{ siteConfig.haunterName }}. {{ siteConfig.haunterPronounSubject | capitalize }} is haunting now.
      {% else %}
        {{ siteConfig.haunterName }} is still with us.
      {% endif %}
    </p>
    <p class="site-footer__accessibility">
      Built with accessibility in mind, for {{ siteConfig.haunterName }}.
      <a href="https://www.w3.org/WAI/standards-guidelines/wcag/" class="site-footer__link" rel="noopener noreferrer" target="_blank">WCAG AAA</a>
    </p>
  </div>
</footer>
